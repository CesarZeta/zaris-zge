# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
# Excepcion: web-app/dist es el build del shell React que GitHub Pages publica
# (ver .github/workflows/deploy-web-app.yml). Versionado intencional.
!web-app/dist/
!web-app/dist/**
env/
venv/
.venv/

# Backend secrets
backend/.env
backend/.env.local

# Backups de la DB de prod (datos reales — NUNCA al repo publico)
backups/
*.dump

# IDE
.vscode/
.idea/

# Agent (Antigravity)
.agent/

# OS
Thumbs.db
.DS_Store

# Documentos técnicos (no deployar)
*.docx
ZARIS_REFERENCIA_PROYECTO.md

# SQL scripts (no van al frontend)
sql/

# Deploy scripts
deploy_to_supabase.py

# Temp
*.tmp
*.log
*.err
uvicorn.*

# Uploads mock (tramites, local storage)
backend/uploads/

# Documentos archivados con info sensible (no versionar)
docs/archivo/

# Folletos comerciales locales (no publicar en GH Pages)
folletos/

# Config local de Claude Code (no versionar), EXCEPTO skills y commands del proyecto.
# Hay que re-incluir cada nivel de directorio: si .claude/ está ignorado, git no
# desciende y las re-inclusiones de subcarpetas no aplican sin esto.
.claude/*
!.claude/skills/
!.claude/commands/

CLAUDE.md.bak
_secmap.txt
_probe.txt
_sec31.txt

_caps/
_*_caps/

# Datasets de referencia reales (VL) para el seed demo - NUNCA versionar (datos personales)
SMOKE/
