# =============================================================================
# ZARIS API — plantilla de variables de entorno
# =============================================================================
# Copiar a .env.local para desarrollo local:  cp .env.example .env.local
# NUNCA commitear .env / .env.local con valores reales (el repo es publico).
# En produccion estas variables viven en Railway (Settings -> Variables),
# no en un archivo. Los valores reales NO se comparten por chat ni por el repo.
# =============================================================================

PROJECT_NAME="ZARIS API"

# --- Base de datos -----------------------------------------------------------
# Local (zaris_dev en Postgres):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_local
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=zaris_dev
# Alternativa: DATABASE_URL completo (tiene prioridad si se setea).
# Local:  postgresql+asyncpg://postgres:tu_password@127.0.0.1:5432/zaris_dev
# Prod:   lo provee Railway/Supabase (NO ponerlo aca).
DATABASE_URL=

# --- Auth JWT ----------------------------------------------------------------
SECRET_KEY=generar_con_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440        # 24h para el JWT scope=agente
JWT_PUBLICO_EXPIRA_DIAS=30              # vigencia del JWT scope=publico (App Vecinos)

# --- Supabase Storage (adjuntos de reclamos / OT / tramites) -----------------
SUPABASE_URL=https://XXXXXXXXXXXXXXXX.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIs...   # service_role key (NO la anon/publishable)
SUPABASE_ADJUNTOS_BUCKET=reclamos-adjuntos

# --- Email (Resend, API HTTP) ------------------------------------------------
# Railway bloquea egress SMTP; se usa Resend por HTTPS. Sin key -> modo MOCK.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=notificaciones@zaris.com.ar   # dominio VERIFICADO en Resend (raiz, NO send.*)

# --- URLs de frontend (links en mails) ---------------------------------------
APP_BASE_URL=https://zge.zaris.com.ar              # shell vanilla (backoffice)
FRONTEND_BASE_URL=https://zge.zaris.com.ar         # links al shell (login, encuestas)
API_PUBLIC_BASE_URL=http://127.0.0.1:8000          # links de mail a endpoints de la API (prod: URL de Railway)
DOMINIO_BASE=zaris.com.ar                         # direcciones por municipio: <sub>.zge|vecinos|agentes.<DOMINIO_BASE> (IT-01 F4)
APP_VECINOS_FRONTEND_URL=http://localhost:5174     # PWA Vecinos (prod: https://vecinos.zaris.com.ar)
APP_AGENTES_FRONTEND_URL=http://localhost:5175     # App de agentes (prod: https://agentes.zaris.com.ar)

# --- Web Push (notificaciones a la App Vecinos) ------------------------------
# Generar el par VAPID una vez. NO commitear la private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:notificaciones@zaris.com.ar

# --- Crons / mantenimiento ---------------------------------------------------
# Token que autentica los endpoints de mantenimiento (encuestas dispatcher,
# tramites retencion, integridad de cuentas). Header X-Dispatcher-Token.
# El de .env.local es de DEV; el de Railway es OTRO (no intercambiables).
DISPATCHER_TOKEN=generar_token_largo_aleatorio

# --- Segundo factor de los niveles 0 y 1 (IT-01 F3b) ---------------------------
# En LOCAL va apagado: los smokes entran con cuentas de nivel 1 en un solo paso
# (smoke_segundo_factor.py lo prende in-process). En Railway NO se setea en false:
# el backend no arranca así fuera de local. Sin la clave y con el segundo factor
# prendido, las cuentas de nivel 0/1 reciben 503.
SEGUNDO_FACTOR_OBLIGATORIO=false
# Clave Fernet de DEV (la de Railway es OTRA). Generarla con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SEGUNDO_FACTOR_CLAVE=generar_con_el_comando_de_arriba
